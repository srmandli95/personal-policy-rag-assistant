APP_NAME=Document RAG
ENV=local

DATABASE_URL=postgresql+psycopg2://personal_policy_rag_assistant:personal_policy_rag_assistant@postgres:5432/personal_policy_rag_assistant
ASYNC_DATABASE_URL=postgresql+asyncpg://personal_policy_rag_assistant:personal_policy_rag_assistant@postgres:5432/personal_policy_rag_assistant
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30

STORAGE_PROVIDER=local
RAW_DOCUMENTS_DIR=/app/data/raw_documents
REDACTED_DOCUMENTS_DIR=/app/data/redacted_documents
EXTRACTED_TEXT_DIR=/app/data/extracted_text
PROCESSED_CHUNKS_DIR=/app/data/processed_chunks
MAX_UPLOAD_SIZE_MB=25
RAG_MAX_RETRIEVAL_ATTEMPTS=2
RAG_MAX_GENERATION_ATTEMPTS=2

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

RERANKER_PROVIDER=local
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_TOP_K=8
INFERENCE_MAX_CONCURRENCY=2
PRELOAD_LOCAL_MODELS=true

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_AUX_MODEL_NAME=gpt-4o-mini
OPENAI_MAX_CONCURRENCY=3
OPENAI_MAX_RETRIES=4
OPENAI_TIMEOUT_SECONDS=60
OPENAI_ANSWER_MAX_TOKENS=600
OPENAI_AUX_MAX_TOKENS=200
PROMPT_MAX_EVIDENCE_CHARS_PER_CHUNK=2500
PROMPT_MAX_EVIDENCE_CHARS=10000
ANSWER_TOP_K=5
API_MAX_CONCURRENT_RAG_REQUESTS=20
ASYNC_RAG_WORKFLOW=true

# Use "worker" for durable jobs; "inline" is intended only for tests/dev.
JOB_EXECUTION_MODE=worker
JOB_POLL_INTERVAL_SECONDS=1.0
JOB_STALE_AFTER_MINUTES=30

JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=rag_session
OAUTH_STATE_COOKIE_NAME=rag_oauth_state
AUTH_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000

# Google OAuth - optional; required only for /auth/google/* endpoints
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
